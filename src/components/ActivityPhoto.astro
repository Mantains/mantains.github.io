---
import { pick, type Lang } from '../lib/site';

interface Props {
  photo: {
    src: string;
    width: number;
    height: number;
    alt: Record<Lang, string>;
    caption: Record<Lang, string>;
  };
  lang: Lang;
  priority?: boolean;
}

const { photo, lang, priority = false } = Astro.props;
---

<figure class:list={['activity-photo', { portrait: photo.height > photo.width }]}>
  <a
    href={photo.src}
    target="_blank"
    rel="noopener"
    aria-label={`${photo.alt[lang]} — ${pick(lang, 'open full-size photo', '查看完整照片')}`}
  >
    <img
      src={photo.src}
      width={photo.width}
      height={photo.height}
      alt={photo.alt[lang]}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  </a>
  <figcaption>{photo.caption[lang]}</figcaption>
</figure>
