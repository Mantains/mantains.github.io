---
import { pick, type Lang } from '../lib/site';
const { lang } = Astro.props as { lang: Lang };
---
<figure class="research-drawing">
  <div class="drawing-label"><span class="status-dot"></span>{pick(lang, 'A FIELD OF QUESTIONS', '从田间出发')}</div>
  <svg viewBox="0 0 360 310" role="img" aria-label={pick(lang, 'Botanical illustration of wheat ears', '麦穗植物线描')}>
