---
import { text, type Lang } from '../lib/site';
const { item, lang } = Astro.props;
const t = text[lang as Lang];
---
<article class="activity-row">
  <div class="activity-meta"><span>{item.date || item.year}</span><span class:list={['badge', { planned: item.status === 'planned' }]}>{t[item.status as 'planned' | 'completed']}</span></div>
  <div><div class="eyebrow">{t[item.category as 'fieldwork']} · {item.location[lang]}</div><h3><a href={`/${lang}/activities/${item.id}/`}>{item.title[lang]} <span aria-hidden="true">↗</span></a></h3><p>{item.summary[lang]}</p></div>
</article>
