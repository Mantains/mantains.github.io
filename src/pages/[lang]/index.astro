---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Publication from '../../components/Publication.astro';
import Activity from '../../components/Activity.astro';
import ResearchDrawing from '../../components/ResearchDrawing.astro';
import { languages, profile, text, publications, activities, publicNotes, noteHref, pick, type Lang } from '../../lib/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = text[lang];
const p = profile[lang];
const selected = publications.filter(p => p.featured).sort((a,b) => (a.order || 0) - (b.order || 0));
const notes = (await publicNotes(lang)).sort((a,b) => Number(b.data.featured) - Number(a.data.featured)).slice(0,3);
---
<SiteLayout lang={lang}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">{p.affiliation}</p>
      <h1>{profile.name}<span>{p.role}</span></h1>
      <p class="hero-tagline">{p.tagline}</p>
      <p class="hero-intro">{p.intro}</p>
      <div class="profile-links"><a href={profile.orcid}>ORCID ↗</a><a href={profile.researchgate}>ResearchGate ↗</a><a href={profile.laboratory}>{p.laboratory} ↗</a><a href={`mailto:${profile.email}`}>{t.email} ↗</a></div>
    </div>
    <ResearchDrawing lang={lang} />
  </section>
  <div class="research-strip"><span class="eyebrow">{t.interests}</span><div>{p.interests.map(i => <span>{i}</span>)}</div></div>
  <section class="home-section">
    <div class="section-heading"><div><span class="eyebrow">01 / RESEARCH</span><h2>{t.selected}</h2></div><a class="text-link" href={`/${lang}/publications/`}>{t.allPublications} <span aria-hidden="true">→</span></a></div>
    {selected.map(item => <Publication item={item} lang={lang} compact />)}
  </section>
  <section class="home-section">
    <div class="section-heading"><div><span class="eyebrow">02 / NOTEBOOK</span><h2>{t.notes}</h2></div><a class="text-link" href={`/${lang}/blog/`}>{t.allNotes} <span aria-hidden="true">→</span></a></div>
    {notes.length ? notes.map(note => <article class="note-row"><span class="eyebrow">{t[note.data.category as 'computing']}</span><h3><a href={noteHref(note)}>{note.data.title} →</a></h3><p>{note.data.description}</p></article>) : <div class="notebook-empty"><span class="notebook-glyph" aria-hidden="true">[ &nbsp; ]</span><div><h3>{t.empty}</h3><p>{t.emptyDescription}</p></div></div>}
    <div class="topic-links"><a href={`/${lang}/blog/?category=bioinformatics`}>{t.bioinformatics} ↗</a><a href={`/${lang}/blog/?category=computing`}>{t.computing} ↗</a><a href={`/${lang}/blog/?category=breeding-statistics`}>{t['breeding-statistics']} ↗</a></div>
  </section>
  <section class="home-section last-section">
    <div class="section-heading"><div><span class="eyebrow">03 / BEYOND THE DESK</span><h2>{t.recent}</h2></div><a class="text-link" href={`/${lang}/activities/`}>{t.allActivities} <span aria-hidden="true">→</span></a></div>
    {activities.filter(a => a.featured).sort((a,b) => a.order - b.order).map(item => <Activity item={item} lang={lang} />)}
  </section>
</SiteLayout>
